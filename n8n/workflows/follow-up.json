{
  "name": "Scout Email - Follow-up Reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "follow-up",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "receive-followup",
      "name": "Receive Follow-up",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-520, 0],
      "webhookId": "scout-email-follow-up",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_IN_N8N",
          "name": "Scout Email Backend Secret"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $('Receive Follow-up').item.json.body.reply_to_message_id }}",
        "emailType": "text",
        "message": "={{ $('Receive Follow-up').item.json.body.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-reply",
      "name": "Gmail Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-260, 0],
      "onError": "continueErrorOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_IN_N8N",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCOUT_EMAIL_BACKEND_URL + '/messages/' + $('Receive Follow-up').item.json.body.message_id + '/provider-result' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scout-Email-Secret",
              "value": "={{ $env.SCOUT_EMAIL_N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({status: 'SENT', provider_message_id: $json.id, provider_thread_id: $json.threadId}) }}",
        "options": {}
      },
      "id": "callback-success",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [10, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCOUT_EMAIL_BACKEND_URL + '/messages/' + $('Receive Follow-up').item.json.body.message_id + '/provider-result' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scout-Email-Secret",
              "value": "={{ $env.SCOUT_EMAIL_N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({status: 'FAILED', error: $json.error?.message || $json.message || 'Gmail reply failed'}) }}",
        "options": {}
      },
      "id": "callback-failure",
      "name": "Callback Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [10, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":true}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [280, 0]
    }
  ],
  "connections": {
    "Receive Follow-up": {
      "main": [
        [
          {
            "node": "Gmail Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail Reply": {
      "main": [
        [
          {
            "node": "Callback Success",
            "type": "main",
            "index": 0
          }
        ],
        [
