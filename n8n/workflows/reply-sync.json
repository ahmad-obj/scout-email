    {
      "parameters": {
        "jsCode": "const j = $json;\nconst rawHeaders = j.payload?.headers ?? j.headers ?? [];\nconst headers = Array.isArray(rawHeaders)\n  ? Object.fromEntries(rawHeaders.filter(h => h?.name).map(h => [String(h.name), String(h.value ?? '')]))\n  : rawHeaders;\nconst from = j.from?.value?.[0]?.address ?? j.from ?? headers.From ?? headers.from ?? '';\nconst subject = j.subject ?? headers.Subject ?? headers.subject ?? '';\nconst body = j.textPlain ?? j.text ?? j.body?.data ?? j.snippet ?? '';\nreturn [{ json: {\n  gmail_thread_id: String(j.threadId ?? j.thread_id ?? ''),\n  gmail_message_id: String(j.id ?? j.messageId ?? ''),\n  from_email: String(from),\n  subject: String(subject),\n  body: String(body),\n  headers,\n  received_at: new Date(Number(j.internalDate ?? Date.now())).toISOString()\n} }];"
      },
      "id": "normalize-message",
      "name": "Normalize Gmail Message",
