        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({lead_id: $json.lead_id}) }}",
        "options": {}
      },
      "id": "dispatch-lead-research",
      "name": "Dispatch Lead Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, -240]
